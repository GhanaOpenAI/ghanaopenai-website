---
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));

const navItems = [
  { label: 'Models', href: '/models' },
  { label: 'Datasets', href: '/datasets' },
  { label: 'Demos & Spaces', href: '/demos' },
  { label: 'Ghana Search', href: 'https://search.ghanaopenai.org', external: true },
  { label: 'About', href: '/about' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-200 transition-all">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-gold-400 rounded-lg p-1">
        <img src="/images/logo.png" alt="Ghana Open AI Logo" class="h-9 sm:h-11 w-auto object-contain transition-transform group-hover:scale-105" />
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold text-neutral-900 leading-tight tracking-tight">
            Ghana Open AI
          </span>
          <span class="text-[11px] font-mono text-neutral-500 uppercase tracking-wider">
            Open-Source AI for Ghana
          </span>
        </div>
      </a>

      <!-- Desktop Nav Items -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-2">
        {navItems.map(item => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class={`px-3.5 py-1.5 rounded-md text-sm font-semibold transition-colors flex items-center gap-1.5 ${
              isActive(item.href)
                ? 'text-neutral-900 bg-neutral-100 font-bold'
                : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'
            }`}
          >
            <span>{item.label}</span>
            {item.external && (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-60">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            )}
          </a>
        ))}
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5">
        <a
          href="https://huggingface.co/ghanaopenai"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-gold-300 text-neutral-900 text-xs sm:text-sm font-bold border border-gold-400 hover:bg-gold-400 transition-colors shadow-sm"
        >
          <span>Hugging Face</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <a
          href="https://github.com/GhanaOpenAI"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-neutral-300 text-neutral-700 text-xs sm:text-sm font-semibold hover:bg-neutral-100 transition-colors"
          title="GitHub Organization"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </div>

    </div>
  </div>
</header>
