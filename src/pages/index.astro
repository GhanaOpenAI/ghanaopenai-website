---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ModelCard from '../components/ModelCard.astro';
import DatasetCard from '../components/DatasetCard.astro';
import SpaceCard from '../components/SpaceCard.astro';

import models from '../data/models.json';
import datasets from '../data/datasets.json';
import spaces from '../data/spaces.json';

const featuredModels = models.slice(0, 6);
const featuredDatasets = datasets.slice(0, 6);
---

<Base title="Ghana Open AI | Open-Source AI for Ghana" appendSiteName={false}>
  <Navigation slot="nav" />

  <!-- Hero Section -->
  <section class="relative bg-paper overflow-hidden border-b border-neutral-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 sm:pt-28 sm:pb-24 lg:pt-32 lg:pb-28">
      <div class="max-w-3xl">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-100 text-gold-900 border border-gold-300 text-xs font-mono font-bold mb-6">
          <span class="w-2 h-2 rounded-full bg-gold-500 animate-pulse"></span>
          <span>Open-Source Artificial Intelligence for Ghana</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-neutral-900 tracking-tight leading-[1.08] mb-6">
          Every Ghanaian language and topic deserves representation in AI.
        </h1>

        <p class="text-lg sm:text-xl text-neutral-600 leading-relaxed mb-10 max-w-2xl">
          We build open-source foundation models, curated speech and text datasets, and retrieval engines for Ghana's linguistic landscape and public knowledge.
        </p>

        <div class="flex flex-wrap items-center gap-3.5">
          <a
            href="/models"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-neutral-900 text-white text-sm font-bold hover:bg-neutral-800 transition-colors shadow-sm"
          >
            Explore 60+ Models
          </a>
          <a
            href="/datasets"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-gold-300 text-neutral-900 border border-gold-400 text-sm font-bold hover:bg-gold-400 transition-colors shadow-sm"
          >
            Browse 100+ Datasets
          </a>
          <a
            href="https://search.ghanaopenai.org"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md border border-neutral-300 text-neutral-800 text-sm font-semibold hover:bg-neutral-100 transition-colors"
          >
            Launch Ghana Search &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Live Stats Strip -->
  <section class="bg-white border-b border-neutral-200 py-10">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-neutral-100">
        <a href="/models" class="group block pt-4 md:pt-0">
          <div class="text-3xl sm:text-4xl font-extrabold text-neutral-900 mb-1 tracking-tight group-hover:text-gold-600 transition-colors">
            63+
          </div>
          <div class="text-xs sm:text-sm font-medium text-neutral-500 uppercase tracking-wider font-mono">
            Open AI Models
          </div>
        </a>

        <a href="/datasets" class="group block pt-4 md:pt-0">
          <div class="text-3xl sm:text-4xl font-extrabold text-neutral-900 mb-1 tracking-tight group-hover:text-gold-600 transition-colors">
            107+
          </div>
          <div class="text-xs sm:text-sm font-medium text-neutral-500 uppercase tracking-wider font-mono">
            Curated Datasets
          </div>
        </a>

        <a href="/models" class="group block pt-4 md:pt-0">
          <div class="text-3xl sm:text-4xl font-extrabold text-neutral-900 mb-1 tracking-tight group-hover:text-gold-600 transition-colors">
            43+
          </div>
          <div class="text-xs sm:text-sm font-medium text-neutral-500 uppercase tracking-wider font-mono">
            Ghanaian Languages
          </div>
        </a>

        <a href="/datasets" class="group block pt-4 md:pt-0">
          <div class="text-3xl sm:text-4xl font-extrabold text-neutral-900 mb-1 tracking-tight group-hover:text-gold-600 transition-colors">
            2,700+
          </div>
          <div class="text-xs sm:text-sm font-medium text-neutral-500 uppercase tracking-wider font-mono">
            Hours Transcribed Speech
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- What We Build Section -->
  <section class="py-20 sm:py-24 bg-paper">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-14">
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-2">Technical Pillars</h2>
        <p class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">
          Sovereign AI infrastructure engineered for Ghana.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="bg-white border border-neutral-200 rounded-lg p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-gold-100 flex items-center justify-center text-gold-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="22"></line>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900">Speech & Voice Synthesis</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Multi-speaker TTS, voice conversion across 25+ local languages, and compact edge ASR models designed for Ghanaian accents.
          </p>
        </div>

        <div class="bg-white border border-neutral-200 rounded-lg p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m5 8 6 6"></path>
              <path d="m4 14 6-6 2-3"></path>
              <path d="M2 5h12"></path>
              <path d="M7 2h1"></path>
              <path d="m22 22-5-10-5 10"></path>
              <path d="M14 18h6"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900">Machine Translation</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Gloss-MT and NLLB models translating between English and Akan/Twi using dictionary-augmented tool calling and reasoning.
          </p>
        </div>

        <div class="bg-white border border-neutral-200 rounded-lg p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-sky-100 flex items-center justify-center text-sky-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900">National Retrieval & MCP</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Ghana Search engine querying 164 government agencies, court rulings, thesis archives, and business registries in under 4.0s.
          </p>
        </div>

        <div class="bg-white border border-neutral-200 rounded-lg p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center text-amber-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900">Curated Local Corpora</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            100+ public datasets covering agriculture (Farmer QA), health consultations, reasoning, parliamentary bills, and code in local languages.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Featured Models Section -->
  <section class="py-20 sm:py-24 bg-white border-t border-neutral-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-2">Open Weights</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">
            Featured Models
          </p>
        </div>
        <a href="/models" class="text-sm font-bold text-neutral-900 hover:text-gold-600 transition-colors inline-flex items-center gap-1">
          <span>View all 63 models</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredModels.map(model => (
          <ModelCard {...model} />
        ))}
      </div>

    </div>
  </section>

  <!-- Featured Datasets Section -->
  <section class="py-20 sm:py-24 bg-paper border-t border-neutral-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-2">Curated Corpus</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">
            Featured Datasets
          </p>
        </div>
        <a href="/datasets" class="text-sm font-bold text-neutral-900 hover:text-emerald-700 transition-colors inline-flex items-center gap-1">
          <span>View all 107 datasets</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredDatasets.map(dataset => (
          <DatasetCard {...dataset} />
        ))}
      </div>

    </div>
  </section>

  <!-- Interactive Spaces & Demos Showcase -->
  <section class="py-20 sm:py-24 bg-white border-t border-neutral-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12">
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 mb-2">Live Applications</h2>
        <p class="text-2xl sm:text-3xl font-extrabold text-neutral-900 tracking-tight">
          Interactive Demos & Benchmarks
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {spaces.map(space => (
          <SpaceCard {...space} />
        ))}
      </div>

    </div>
  </section>

  <!-- Open Community & Mission CTA -->
  <section class="py-20 sm:py-24 bg-neutral-900 text-white relative overflow-hidden">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-6">
        Built for Ghanaian developers, researchers, and creators.
      </h2>
      <p class="text-base sm:text-lg text-neutral-300 leading-relaxed mb-10 max-w-2xl mx-auto">
        All our weights, training datasets, and benchmarks are published openly without paywalls. Connect your local models, run inference offline, or contribute back to the community.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://huggingface.co/ghanaopenai"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-md bg-gold-300 text-neutral-900 font-bold hover:bg-gold-400 transition-colors"
        >
          Follow on Hugging Face &rarr;
        </a>
        <a
          href="https://github.com/GhanaOpenAI"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-md bg-neutral-800 text-white border border-neutral-700 font-bold hover:bg-neutral-700 transition-colors"
        >
          Star on GitHub &rarr;
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
