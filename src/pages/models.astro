---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ModelCard from '../components/ModelCard.astro';
import models from '../data/models.json';
---

<Base
  title="Models & Weights"
  description="Explore 63+ open-source AI models developed for Ghanaian speech, translation, and language understanding."
>
  <Navigation slot="nav" />

  <!-- Header Banner -->
  <section class="pt-24 pb-16 sm:pt-28 sm:pb-20 bg-mist border-b border-neutral-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-100 text-gold-900 border border-gold-300 text-xs font-mono font-bold mb-4">
          <span>Hugging Face Hub</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 tracking-tight mb-4">
          Open-Source Models & Weights
        </h1>
        <p class="text-base sm:text-lg text-neutral-600 leading-relaxed max-w-2xl">
          Foundation voice models, voice conversion across 25+ Ghanaian languages, compact ASR, and reasoning machine translation. All weights are freely available on Hugging Face.
        </p>
      </div>
    </div>
  </section>

  <!-- Models Grid -->
  <section class="py-16 sm:py-20 bg-paper">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-8">
        <span class="text-sm font-mono text-neutral-500 font-semibold">
          Showing {models.length} open models
        </span>
        <a
          href="https://huggingface.co/ghanaopenai"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-bold font-mono text-neutral-700 hover:text-neutral-900 transition-colors uppercase tracking-wider"
        >
          View Organization on HuggingFace &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {models.map(model => (
          <ModelCard {...model} />
        ))}
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</Base>
